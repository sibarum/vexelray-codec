<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.codec</groupId>
        <artifactId>vexelray-codec</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>vexelray-codec-image</artifactId>
    <packaging>jar</packaging>

    <name>vexelray-codec-image</name>
    <description>
        Pictures on a VexelRay GUI. imagelib-wrapper turns a file into frames of RGBA8; this packs them into one
        sheet sized for the GPU (off the GUI thread), uploads each sheet once and keeps the recent ones, and shows
        one on a node: fitted, animated where the file is, over a backdrop for its transparent pixels.
    </description>

    <!--
      Two packages, split where the GUI starts:

        dev.vexelray.codec.image       pixels and nothing else. No GUI type, blocking, run on Gui.offload().
        dev.vexelray.codec.image.gui   the GPU and the tree: Textures, ImageView, and ImageStarter, which an
                                       application names in @VexelApp(starters) to have Textures built and bound
                                       to its window for it.

      Portable. The only native code is the decoder, and that is imagelib-wrapper's, which bundles its library per
      platform under natives/<os>-<arch>/ and loads the one for the host. Nothing here names an OS.
    -->
    <dependencies>
        <dependency>
            <groupId>sibarum.imagelib</groupId>
            <artifactId>imagelib-wrapper</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-draw</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-canvas</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-vulkan</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.kronometer</groupId>
            <artifactId>kronometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.kronometer</groupId>
            <artifactId>kronometer-anim</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.atchung</groupId>
            <artifactId>atchung-probe</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-api</artifactId>
        </dependency>

        <!-- ImageStarterTest compiles applications against the starter with the real processor and the real
             shell, as AutomationStarterTest does in the framework. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-processor</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
