<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      The smallest application that plays a video: one VideoView filling a window, for seeing vexelray-codec-video on a
      real GPU and driving it with ottermate. Not a module of vexelray-codec, so installing the library never builds an
      application. README.md says how to run and drive it.
    -->
    <groupId>dev.vexelray.codec</groupId>
    <artifactId>video-player-demo</artifactId>
    <version>0.1.1-SNAPSHOT</version>

    <name>video-player-demo</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-framework.version>0.1.1-SNAPSHOT</vexelray-framework.version>
        <vexelray-gui.version>0.1.1-SNAPSHOT</vexelray-gui.version>
        <vexelray.version>0.1.1-SNAPSHOT</vexelray.version>
        <tactroller.version>1.1-SNAPSHOT</tactroller.version>
        <vexelray-codec.version>0.1.1-SNAPSHOT</vexelray-codec.version>

        <app.mainClass>dev.vexelray.codec.demo.video.Player</app.mainClass>
        <!-- The file to play, and any setting. Split on whitespace, so a path with a space will not do. -->
        <app.args></app.args>
        <automation>off</automation>
        <app.jvmArgs></app.jvmArgs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- VideoView, and through it the image module's Textures and ImageStarter. -->
        <dependency>
            <groupId>dev.vexelray.codec</groupId>
            <artifactId>vexelray-codec-video</artifactId>
            <version>${vexelray-codec.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>dev.vexelray.framework</groupId>
                            <artifactId>vexelray-framework-processor</artifactId>
                            <version>${vexelray-framework.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dstdout.encoding=UTF-8 -Dautomation=${automation} ${app.jvmArgs} -classpath %classpath ${app.mainClass} ${app.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
